ORBIT_ENV=dev
ORBIT_PORT=8787
ORBIT_DB_PATH=./data/orbit.db

# --- Local LLM ---
# Backend: "ollama" (probe /api/tags) or "openai" (probe /v1/models) — chat always uses /v1/chat/completions

# Option A — Ollama (default)
# LOCAL_LLM_BACKEND=ollama
# LOCAL_LLM_URL=http://127.0.0.1:11434
# LOCAL_LLM_MODEL=qwen2.5:7b-instruct-q4_K_M

# Option B — MLX-LM on Apple Silicon (use if Ollama runner crashes, e.g. some M5 Macs)
LOCAL_LLM_BACKEND=openai
LOCAL_LLM_URL=http://127.0.0.1:8080
LOCAL_LLM_MODEL=mlx-community/Llama-3.2-3B-Instruct-4bit

# Completion length (OpenAI-style max_tokens on /v1/chat/completions). Lower = faster, shorter replies.
# CHAT_MAX_TOKENS_LOCAL=768
# CHAT_MAX_TOKENS_CLOUD=1024

# Legacy: OLLAMA_BASE_URL and OLLAMA_MODEL still work if LOCAL_LLM_* are unset

# --- Cloud tier (OpenAI-compatible /v1/chat/completions) ---
# Used when route is cloud (long message, keywords, or Mac route_hint).
# Point CLOUD_BASE_URL at OpenAI, Gemini’s OpenAI-compat host, or a LiteLLM proxy (see README).
CLOUD_API_KEY=
# CLOUD_BASE_URL=https://api.openai.com
# CLOUD_MODEL=gpt-4o-mini
#
# Long-message heuristic: server routes to cloud when the user message is longer than this (characters).
# CLOUD_FALLBACK_MIN_CHARS=1200
#
# Before calling the cloud API, scrub email / US phone / SSN-shaped runs from every message block.
# Set to 0/false/off to send raw text (not recommended). Default: on.
# CLOUD_REDACT_PII=true

# Optional privacy-at-rest mode: redact PII before writing turns/facts/auto-semantic memories to local SQLite.
# Default: off (keeps full local history for best recall fidelity).
# REDACT_LOCAL_STORAGE=false

# Optional structured chat audit log (JSONL). Stores route/model/timing/size metadata only (no raw chat text).
# Leave empty to disable.
# CHAT_AUDIT_LOG_PATH=./data/chat_audit.jsonl
# Rotate when file reaches this size (bytes); keeps numbered backups.
# CHAT_AUDIT_MAX_BYTES=2000000
# CHAT_AUDIT_BACKUP_COUNT=4

# Minimal semantic memory scaffold (auto-extract personal/context clues from user messages,
# store local hashed vectors in SQLite, and recall relevant items into the system prompt).
# SEMANTIC_MEMORY_ENABLED=true
# Importance threshold for auto-extracted semantic memories (0.1..0.95; higher = stricter).
# SEMANTIC_MEMORY_MIN_SCORE=0.56
# Retention policy for semantic memory rows.
# SEMANTIC_MEMORY_RETENTION_DAYS=90
# SEMANTIC_MEMORY_MAX_ITEMS=500
